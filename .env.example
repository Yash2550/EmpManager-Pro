# ─────────────────────────────────────────────────────────────
#  EmpManager Pro — Deployment Environment Template
#  ✅ Safe to commit to Git — contains NO real credentials.
#  On Render/Railway: set these as environment variables in their dashboard.
#  For local dev: copy to .env and fill in real values.
# ─────────────────────────────────────────────────────────────

# ── Flask Core ────────────────────────────────────────────────
SECRET_KEY=your-strong-random-secret-key-here
FLASK_ENV=production
FLASK_DEBUG=0

# ── Database — Supabase PostgreSQL ────────────────────────────
# Get from: Supabase Dashboard → Settings → Database → URI tab
# Mode: Session (port 5432) — NOT Transaction (port 6543)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── OR use individual connection params (alternative) ─────────
# SUPABASE_HOST=db.xxxxxxxxxxxx.supabase.co
# SUPABASE_USER=postgres
# SUPABASE_PASSWORD=your-password
# SUPABASE_PORT=5432
# SUPABASE_DB=postgres

# ── AI / Groq ─────────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama3-8b-8192

# ── Twilio Voice Agent ────────────────────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
